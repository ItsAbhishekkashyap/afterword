# Required: Mistral (titles, summaries, extraction, chat and embeddings)
MISTRAL_API_KEY=
# Required for English transcription: Groq (free key at https://console.groq.com)
GROQ_API_KEY=
# Required for Hinglish: Sarvam AI speech-to-text-translate
SARVAM_API_KEY=

# Engines: groq | local   and   mistral | local   (local needs requirements-local.txt)
TRANSCRIBE_ENGINE=groq
EMBEDDINGS=mistral
# Optional model overrides
GROQ_STT_MODEL=whisper-large-v3
WHISPER_MODEL=base
SARVAM_STT_MODEL=saaras:v2.5

# YouTube on cloud servers: if YouTube blocks the audio download, the video's captions are fetched
# through Supadata instead (free key, no card: https://supadata.ai). YOUTUBE_SOURCE=download | captions
SUPADATA_API_KEY=
YOUTUBE_SOURCE=download
# Optional, rarely needed: cookies.txt of a signed-in YouTube account (text or file path)
YTDLP_COOKIES=
YTDLP_COOKIES_FILE=

# Comma-separated origins allowed to call the API (your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
# Optional regex, e.g. to allow Vercel preview deployments: https://afterword-.*\.vercel\.app
CORS_ORIGIN_REGEX=
