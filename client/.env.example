# Where the FastAPI server (api/main.py) is running
NEXT_PUBLIC_API_URL=http://localhost:8000
# Largest upload accepted, in MB (match the server's MAX_UPLOAD_MB)
NEXT_PUBLIC_MAX_UPLOAD_MB=500
# Show the "paste a YouTube link" option (only when the server has ALLOW_LINKS=true, e.g. on your PC)
NEXT_PUBLIC_ALLOW_LINKS=false
# Public URL of this site, used for SEO metadata (falls back to the Vercel URL)
NEXT_PUBLIC_SITE_URL=
